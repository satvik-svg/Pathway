# =============================================================================
# Local development (Nhost CLI / local)
# =============================================================================
NEXT_PUBLIC_NHOST_SUBDOMAIN=local
NEXT_PUBLIC_NHOST_REGION=
NEXT_PUBLIC_NHOST_AUTH_URL=http://local.auth.nhost.run:1337/v1
NEXT_PUBLIC_NHOST_GRAPHQL_URL=http://local.hasura.nhost.run:1337/v1/graphql
NEXT_PUBLIC_NHOST_STORAGE_URL=http://local.storage.nhost.run:1337/v1
NEXT_PUBLIC_NHOST_FUNCTIONS_URL=http://local.functions.nhost.run:1337/v1

# Next.js API proxy target (server-only). Local engine:
NHOST_FUNCTIONS_URL=http://127.0.0.1:4001

# =============================================================================
# Production (Vercel + Nhost Cloud) — set these in Vercel Project → Settings → Env
# Example subdomain from console: fnhytukrqguwrogfryxo / ap-south-1
# =============================================================================
# NEXT_PUBLIC_NHOST_SUBDOMAIN=fnhytukrqguwrogfryxo
# NEXT_PUBLIC_NHOST_REGION=ap-south-1
# NEXT_PUBLIC_NHOST_AUTH_URL=https://fnhytukrqguwrogfryxo.auth.ap-south-1.nhost.run/v1
# NEXT_PUBLIC_NHOST_GRAPHQL_URL=https://fnhytukrqguwrogfryxo.graphql.ap-south-1.nhost.run/v1
# NEXT_PUBLIC_NHOST_STORAGE_URL=https://fnhytukrqguwrogfryxo.storage.ap-south-1.nhost.run/v1
# NEXT_PUBLIC_NHOST_FUNCTIONS_URL=https://fnhytukrqguwrogfryxo.functions.ap-south-1.nhost.run/v1
#
# Server-only on Vercel — REQUIRED for create-org / members (runs on Vercel, not Nhost lambda):
# NHOST_GRAPHQL_URL=https://fnhytukrqguwrogfryxo.graphql.ap-south-1.nhost.run/v1
# NHOST_ADMIN_SECRET=<from Nhost dashboard → Hasura → Admin Secret>
#
# Optional: proxy other functions to Nhost (trigger run, etc.)
# NHOST_FUNCTIONS_URL=https://fnhytukrqguwrogfryxo.functions.ap-south-1.nhost.run/v1
#
# Nhost function secrets (if you still deploy handlers there):
# GROQ_API_KEY=
# LLM_STUB=false
